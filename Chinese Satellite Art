<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Chinese Satellite Art Archive</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    min-height:100vh;
    font-family:
    "Helvetica Neue",
    Arial,
    sans-serif;

    color:#fff;

    background:
    radial-gradient(circle at top,#162536 0%,#05070b 45%,#000 100%);

}


/* ---------- Header ---------- */

header{

    padding:80px 10% 50px;

}

.title{

    font-size:48px;
    letter-spacing:3px;

}

.subtitle{

    margin-top:20px;

    color:#b8c7d9;

    max-width:700px;

    line-height:1.8;

}


/* ---------- Navigation ---------- */

nav{

    position:sticky;

    top:0;

    background:
    rgba(0,0,0,.65);

    backdrop-filter:blur(10px);

    padding:20px 10%;

    border-bottom:
    1px solid rgba(255,255,255,.1);

}


nav a{

    color:white;

    text-decoration:none;

    margin-right:35px;

    font-size:14px;

}



/* ---------- Statistics ---------- */


.stats{

    display:flex;

    gap:30px;

    padding:30px 10%;

}


.stat{

    flex:1;

    padding:30px;

    border-radius:20px;

    background:
    rgba(255,255,255,.06);

    border:
    1px solid rgba(255,255,255,.15);

}


.number{

    font-size:40px;

    font-weight:bold;

}



/* ---------- Timeline ---------- */

.timeline{

    padding:60px 10%;

}


.item{

    margin-bottom:40px;

    padding:35px;

    border-radius:20px;

    background:
    linear-gradient(
    135deg,
    rgba(255,255,255,.08),
    rgba(255,255,255,.02)
    );

    border:
    1px solid rgba(255,255,255,.12);

    transition:.4s;

}


.item:hover{

    transform:translateY(-8px);

    border-color:#6fa8ff;

}


.year{

    color:#79b8ff;

    font-size:20px;

}


.name{

    font-size:28px;

    margin:15px 0;

}


.info{

    line-height:2;

    color:#d7dce5;

}



.tag{

    display:inline-block;

    padding:6px 15px;

    margin:8px 8px 0 0;

    border-radius:20px;

    background:
    rgba(120,180,255,.15);

    color:#9ed0ff;

    font-size:13px;

}



/* ---------- Footer ---------- */


footer{

    padding:60px 10%;

    color:#888;

    text-align:center;

}

</style>


</head>


